rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Profiles: users can only read and write their own profile
    match /profiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Expenses: users can only manage their own expenses
    match /expenses/{expenseId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Budgets: users can only manage their own budget
    match /budgets/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Chat History: users can only access their own conversation logs
    match /chats/{chatId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
